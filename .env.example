# Copy to .env for local runs. On Render, set these in the service's Environment tab instead.

# ---- required ----
DISCORD_TOKEN=
# Neon pooled connection string (the -pooler host). sslmode/channel_binding params are fine.
DATABASE_URL=

# ---- core ----
# Sync slash commands to one server instantly while developing. Leave empty in production.
DEV_GUILD_ID=
# true = sync global commands on startup (production). Ignored when DEV_GUILD_ID is set.
SYNC_COMMANDS=false
# "disable" only for a local Postgres without TLS
DATABASE_SSL=require
# Who can use owner-only commands like /sync: user IDs, comma-separated. Empty = the Discord app's owner/team.
OWNER_IDS=
# true (default) = per server, only the server owner and the members they allow in the panel (Access) can use
# commands and the panel; the OWNER_IDS above can everywhere. false = permission-based.
OWNER_ONLY=true
# true = keep the settings commands the control panel replaces (/config, /welcome, /setup, ...)
CONFIG_COMMANDS=false
# Prefix for the text commands (the voice commands, e.g. !disconnect all). Mentioning the bot also works.
PREFIX=!
PORT=8080
LOG_LEVEL=INFO

# ---- logging feature: server stats counters ----
# How often pending counter changes are applied, and how often every counter is re-checked (seconds)
STATS_UPDATE_INTERVAL=30
STATS_RECONCILE_INTERVAL=600

# ---- nickname feature ----
# Pause between renames in a bulk /nick job (seconds)
RENAME_DELAY_SECONDS=1.0
